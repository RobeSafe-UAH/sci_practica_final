  <version>0.1.0</version>
  <description>Simulación de la práctica final de SCI con tráfico y sensores ROS 2.</description>
  <maintainer email="sci@example.com">SCI</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
