  79a61ea7c14172b5bd736b0447b58c75da19c7af,
  src/base_system/rbsf_mvsim/definitions/f1tenth.vehicle.xml.
  Changes: configurable Ackermann dimensions/limits, SCI LiDAR and eight
  independent sonar scan origins. Local RoboRacer visual meshes and poses
  derive from f1tenth_gym_ros (MIT); see assets/rbsf_racing/PROVENANCE.md.
  The body origin is the rear axle; X forward, Y left, Z up.
-->
<vehicle:class name="sci_ego">
  <dynamics class="ackermann">
    <rl_wheel pos="0 0.148" mass="0.2" width="0.045" diameter="0.109"/>
    <rr_wheel pos="0 -0.148" mass="0.2" width="0.045" diameter="0.109"/>
    <fl_wheel mass="0.2" width="0.045" diameter="0.109"/>
    <fr_wheel mass="0.2" width="0.045" diameter="0.109"/>
    <f_wheels_x>${wheelbase|0.3302}</f_wheels_x>
    <f_wheels_d>0.296</f_wheels_d>
    <max_steer_ang_deg>${max_steer_deg|24.0}</max_steer_ang_deg>
    <chassis mass="3.5" zmin="0.03" zmax="0.18" color="#3080ff">
      <shape>
        <pt>0.45 0.15</pt><pt>0.45 -0.15</pt>
        <pt>-0.13 -0.15</pt><pt>-0.13 0.15</pt>
      </shape>
    </chassis>
    <controller class="twist_front_steer_pid">
      <KP>15.0</KP><KI>2.0</KI><I_MAX>15.0</I_MAX><KD>0.5</KD>
      <V>0.0</V><W>0.0</W><max_torque>25.0</max_torque>
    </controller>
  </dynamics>
  <friction class="default"><mu>1.2</mu><C_damping>0.002</C_damping></friction>
  <!-- Visuals only: the explicit chassis shape and Ackermann dynamics above
       remain authoritative. Mesh poses follow racecar_mesh.xacro at scale 1.
       Model angles are degrees in MVSim, ordered as roll/pitch/yaw. -->
  <visual>
    <name>roboracer_chassis</name>
    <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../assets/rbsf_racing/roboracer_chassis.glb</model_uri>
  </visual>
  <visual>
    <name>roboracer_accent</name>
    <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../assets/rbsf_racing/roboracer_accent.stl</model_uri>
    <model_color>#3080ff</model_color>
  </visual>
  <visual>
    <name>roboracer_lidar</name>
    <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../assets/rbsf_racing/roboracer_lidar.glb</model_uri>
    <model_offset_x>0.266962</model_offset_x>
    <model_offset_y>0.000249</model_offset_y>
    <model_offset_z>0.121636</model_offset_z>
  </visual>
  <visual>
    <name>roboracer_wheel_rear_left</name>
    <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../assets/rbsf_racing/roboracer_wheel_rear_left.glb</model_uri>
    <model_offset_x>-0.000833</model_offset_x>
    <model_offset_y>0.130772</model_offset_y>
    <model_offset_z>0.051076</model_offset_z>
    <model_roll>-2.543</model_roll><model_pitch>-0.005</model_pitch><model_yaw>-0.246</model_yaw>
  </visual>
  <visual>
    <name>roboracer_wheel_rear_right</name>
    <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../assets/rbsf_racing/roboracer_wheel_rear_right.glb</model_uri>
    <model_offset_x>0.000833</model_offset_x>
    <model_offset_y>-0.132075</model_offset_y>
    <model_offset_z>0.050856</model_offset_z>
    <model_roll>2.932</model_roll><model_pitch>0.007</model_pitch><model_yaw>-0.290</model_yaw>
  </visual>
  <visual>
    <name>roboracer_wheel_front_left</name>
    <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../assets/rbsf_racing/roboracer_wheel_front_left.glb</model_uri>
    <model_offset_x>0.321733</model_offset_x>
    <model_offset_y>0.132904</model_offset_y>
    <model_offset_z>0.051058</model_offset_z>
    <model_roll>-3.574</model_roll><model_pitch>0.068</model_pitch><model_yaw>2.177</model_yaw>
  </visual>
  <visual>
    <name>roboracer_wheel_front_right</name>
    <model_uri>${MVSIM_CURRENT_FILE_DIRECTORY}/../assets/rbsf_racing/roboracer_wheel_front_right.glb</model_uri>
    <model_offset_x>0.320602</model_offset_x>
    <model_offset_y>-0.131600</model_offset_y>
    <model_offset_z>0.050883</model_offset_z>
    <model_roll>1.899</model_roll><model_pitch>-0.046</model_pitch><model_yaw>2.803</model_yaw>
  </visual>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/lidar.sensor.xml"
           sensor_x="${lidar_x|0.27}" sensor_y="${lidar_y|0.0}" sensor_z="${lidar_z|0.15}"/>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/sonar_scan.sensor.xml" sensor_name="sonar0_scan"
           sensor_x="${sonar0_x|0.46}" sensor_y="${sonar0_y|0.0}" sensor_yaw="${sonar0_yaw_deg|0}"/>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/sonar_scan.sensor.xml" sensor_name="sonar1_scan"
           sensor_x="${sonar1_x|0.40}" sensor_y="${sonar1_y|0.16}" sensor_yaw="${sonar1_yaw_deg|45}"/>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/sonar_scan.sensor.xml" sensor_name="sonar2_scan"
           sensor_x="${sonar2_x|0.16}" sensor_y="${sonar2_y|0.17}" sensor_yaw="${sonar2_yaw_deg|90}"/>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/sonar_scan.sensor.xml" sensor_name="sonar3_scan"
           sensor_x="${sonar3_x|-0.14}" sensor_y="${sonar3_y|0.14}" sensor_yaw="${sonar3_yaw_deg|135}"/>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/sonar_scan.sensor.xml" sensor_name="sonar4_scan"
           sensor_x="${sonar4_x|-0.15}" sensor_y="${sonar4_y|0.0}" sensor_yaw="${sonar4_yaw_deg|180}"/>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/sonar_scan.sensor.xml" sensor_name="sonar5_scan"
           sensor_x="${sonar5_x|-0.14}" sensor_y="${sonar5_y|-0.14}" sensor_yaw="${sonar5_yaw_deg|-135}"/>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/sonar_scan.sensor.xml" sensor_name="sonar6_scan"
           sensor_x="${sonar6_x|0.16}" sensor_y="${sonar6_y|-0.17}" sensor_yaw="${sonar6_yaw_deg|-90}"/>
  <include file="${MVSIM_CURRENT_FILE_DIRECTORY}/sonar_scan.sensor.xml" sensor_name="sonar7_scan"
           sensor_x="${sonar7_x|0.40}" sensor_y="${sonar7_y|-0.16}" sensor_yaw="${sonar7_yaw_deg|-45}"/>
</vehicle:class>
