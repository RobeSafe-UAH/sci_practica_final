<sensor class="laser" name="scan">
  <pose_3d>${sensor_x|0.27} ${sensor_y|0.0} ${sensor_z|0.15} 0 0 0</pose_3d>
  <fov_degrees>${lidar_fov_degrees|270}</fov_degrees>
  <sensor_period>${lidar_period|0.05}</sensor_period>
  <nrays>${lidar_nrays|1081}</nrays>
  <min_range>0.04</min_range>
  <max_range>${lidar_max_range|12.0}</max_range>
  <range_std_noise>0.005</range_std_noise>
  <angle_std_noise_deg>0.0</angle_std_noise_deg>
  <raytrace_3d>false</raytrace_3d>
  <visual enabled="false"/>
  <publish enabled="false"/>
  <viz_visiblePoints>true</viz_visiblePoints>
  <viz_pointSize>2</viz_pointSize>
  <viz_visiblePlane>false</viz_visiblePlane>
  <viz_visibleLines>false</viz_visibleLines>
  <viz_pointsColor>#ff303080</viz_pointsColor>
</sensor>
