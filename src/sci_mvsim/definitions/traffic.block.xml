<!-- SPDX-License-Identifier: Apache-2.0
     SCI moving box footprint, animated by native MVSim keyframes in world.xml.
     A static body follows the animation and remains solid to ego and sensors.
     The origin is the centre of the box; dimensions are supplied by world.py.
     No external visual models. -->
<block:class name="sci_traffic">
  <static>true</static>
  <intangible>false</intangible>
  <mass>3.5</mass>
  <zmin>0.0</zmin><zmax>${box_height|0.45}</zmax>
  <color>#ff9020</color>
  <shape>
    <pt>${box_x_max|0.45} ${box_y_max|0.275}</pt>
    <pt>${box_x_max|0.45} ${box_y_min|-0.275}</pt>
    <pt>${box_x_min|-0.45} ${box_y_min|-0.275}</pt>
    <pt>${box_x_min|-0.45} ${box_y_max|0.275}</pt>
  </shape>
</block:class>
