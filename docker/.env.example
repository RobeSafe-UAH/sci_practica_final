# Copy to docker/.env to configure the simulator's ROS domain and browser desktop.
ROS_DOMAIN_ID=42

# Local browser desktop: http://localhost:6080/vnc.html
SCI_VNC_PORT=6080
SCI_SCREEN_WIDTH=1280
SCI_SCREEN_HEIGHT=800

# Hides MVSim's window; the virtual desktop remains available for diagnostics.
SCI_HEADLESS=false

# DDS discovery. Optional peers use semicolon-separated reachable IP addresses.
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROS_STATIC_PEERS=
