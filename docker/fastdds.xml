<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- ROS participants outside this container do not share its /dev/shm. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>sci_udp_v4</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="sci_udp_only" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>sci_udp_v4</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
